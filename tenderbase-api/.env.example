# ---------------------------------------------------------------------------
# TenderBase API — example environment configuration
# Copy to .env and adjust. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

APP_ENV=development            # development | staging | production | test
APP_NAME=TenderBase API
APP_VERSION=0.1.0
DEBUG=true

# API
API_PREFIX=/api
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=["*"]

# Security — generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# Database (async SQLAlchemy URL). In docker compose the host is "postgres".
DATABASE_URL=postgresql+psycopg://tenderbase:tenderbase@localhost:5432/tenderbase
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# Redis / worker queue (optional for the read API; required for workers)
REDIS_URL=redis://localhost:6379/0

# Ingestion / HTTP client defaults
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE_SECONDS=0.5
HTTP_MAX_RESPONSE_BYTES=26214400        # 25 MiB
HTTP_MAX_REDIRECTS=5
HTTP_USER_AGENT=TenderBaseBot/0.1 (+https://tenderbase.example/bot; contact=ops@example.com)
HTTP_RESPECT_ROBOTS=true
HTTP_DEFAULT_RATE_LIMIT_PER_MINUTE=30
HTTP_ALLOW_PRIVATE_NETWORKS=false       # SSRF guard; keep false outside tests

# Documents
DOCUMENT_STORAGE_BACKEND=local          # local | s3 (s3 not implemented yet)
DOCUMENT_STORAGE_PATH=./data/documents
DOCUMENT_MAX_BYTES=104857600            # 100 MiB
RAW_PAYLOAD_STORAGE_PATH=./data/raw
RAW_PAYLOAD_INLINE_MAX_BYTES=65536      # larger raw payloads go to the blob store

# OCR (optional; disabled by default — OCR is expensive)
OCR_ENABLED=false
OCR_LANGUAGES=eng

# AI enrichment (OPTIONAL — the core API must start and run without these)
AI_ENABLED=false
AI_PROVIDER=null                        # null | openai | anthropic
AI_API_KEY=
AI_MODEL=

# Pagination limits
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100

# Rate limiting (extension point; disabled by default)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_ANONYMOUS_PER_MINUTE=60
