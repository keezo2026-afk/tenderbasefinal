# ---------------------------------------------------------------------------
# TenderBase API — example environment configuration
#
# Copy to .env and adjust. NEVER commit a real .env file.
# Every value below is the built-in default (see app/config.py); uncomment and
# change only what you need. Nothing here is a secret.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_ENV=development            # development | staging | production | test
APP_NAME=TenderBase API
APP_VERSION=0.1.0
DEBUG=false                      # errors echo extra detail outside production; startup refuses true in production
API_PREFIX=/api

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false                 # true in production: log aggregation needs JSON lines

# --- CORS ------------------------------------------------------------------
# No browser client is part of this repository, so the default is empty and
# cross-origin requests are refused. '*' is rejected outright in production:
# a wildcard with credentials on a data API is a data-exfiltration path for
# nothing. List concrete origins if you add a web consumer:
# CORS_ORIGINS=["https://tenderbase.example"]

# --- Security / authentication ---------------------------------------------
# Used for the API-key HMAC pepper when API_KEY_PEPPER is unset. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
# Set this once and keep it stable: rotating SECRET_KEY (or this pepper)
# invalidates every issued API key, which is the intended fail-closed behaviour
# when a secret leaks.
# API_KEY_PEPPER=
API_KEY_HEADER=X-API-Key
# Require a valid, correctly scoped API key on every data endpoint. Defaults to
# true in production/staging (where it cannot be turned off) and false in
# development/test. Health probes are never authenticated.
# API_KEY_ENFORCEMENT_ENABLED=true
# Mint keys through the HTTP API? Keep false in production — issuing
# credentials should be an audited operator action:
#   python -m scripts.manage_api_keys create --name "partner X" --scope read:tenders
API_KEY_SELF_SERVICE_ENABLED=false
ALLOW_UNAUTHENTICATED_HEALTH=true

# --- Metrics endpoint ------------------------------------------------------
METRICS_ENABLED=true
METRICS_PATH=/metrics
# Prometheus scrape credential. Unset = /metrics is open to whoever can reach
# the port (fine on a private network, not fine on a public one). The value is
# compared in constant time; the endpoint is never part of the OpenAPI schema.
# METRICS_TOKEN=

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://tenderbase:tenderbase@localhost:5432/tenderbase
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false
# Pool saturation is exported as tenderbase_db_pool_connections{state=...}
# on /metrics; raise these if that gauge pins at DB_POOL_SIZE.

# --- Redis / workers -------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
WORKER_MAX_JOBS=5
WORKER_JOB_TIMEOUT_SECONDS=900
WORKER_KEEP_RESULT_SECONDS=3600
# Retries per job for *transient* failures (network, 5xx, DB deadlock).
# Permanent failures — parse errors, schema changes — are not retried.
WORKER_MAX_TRIES=3
WORKER_RETRY_BACKOFF_SECONDS=5.0

# --- Scheduling, claiming and job recovery ---------------------------------
# A claim is a lease, not a lock: if a worker dies, the source becomes claimable
# again once this passes. Must be >= WORKER_JOB_TIMEOUT_SECONDS, or a second
# scheduler could claim a source whose worker is still crawling it.
SOURCE_CLAIM_LEASE_SECONDS=1800
# How often the worker compares ingestion_jobs against the queue and repairs what
# it finds (lost dispatches, jobs that never finished, runs stuck in RUNNING).
JOB_RECONCILIATION_INTERVAL_SECONDS=300
# A QUEUED row older than this was never dispatched: the enqueue failed, or the API
# wrote the row and died before reaching Redis.
JOB_QUEUED_STALE_AFTER_SECONDS=900
# Extra time past WORKER_JOB_TIMEOUT_SECONDS before a RUNNING row is called stuck.
# Deliberately generous: ARQ enforces its own timeout, and a reconciler that fires
# first would abort work that is merely slow.
JOB_RUNNING_GRACE_SECONDS=300
# Re-enqueue jobs lost in the queue instead of only marking them failed. Set false
# to make recovery visible-but-manual.
RECONCILE_REENQUEUE=true

# --- Source freshness --------------------------------------------------------
# "How out of date is unacceptable" is a product decision, so it is configuration:
# a source with no successful run for this long is AGING, then STALE.
FRESHNESS_AGING_HOURS=36
FRESHNESS_STALE_HOURS=96

# --- Ingestion HTTP client -------------------------------------------------
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE_SECONDS=0.5
HTTP_MAX_RESPONSE_BYTES=26214400        # 25 MiB
HTTP_MAX_REDIRECTS=5
# Set a contact address in your deployment so a site operator can ask you to
# slow down instead of blocking the IP: TenderBaseBot/1.0 (+https://you/bot; contact=ops@you)
HTTP_USER_AGENT=TenderBaseBot/0.1 (+https://tenderbase.example/bot)
HTTP_RESPECT_ROBOTS=true
HTTP_DEFAULT_RATE_LIMIT_PER_MINUTE=30   # per-source crawl politeness default
# SSRF guard. false refuses loopback/private/link-local addresses and cloud
# metadata endpoints. There is no supported reason to enable it in production:
# tests use their own settings object rather than this variable.
HTTP_ALLOW_PRIVATE_NETWORKS=false
# Ports the fetcher may contact. Public procurement portals occasionally live on
# 8080/8443 (e.g. legacy SAP Portal deployments), so those are allowed in
# addition to 80/443; any other port is refused as a likely SSRF attempt.
# Comma-separated. Widen deliberately, per deployment, and record why.
HTTP_ALLOWED_PORTS=80,443,8080,8443

# --- Documents -------------------------------------------------------------
DOCUMENT_STORAGE_BACKEND=local          # local | s3 (s3 not implemented yet)
DOCUMENT_STORAGE_PATH=./data/documents
DOCUMENT_MAX_BYTES=104857600            # 100 MiB
RAW_PAYLOAD_STORAGE_PATH=./data/raw
RAW_PAYLOAD_INLINE_MAX_BYTES=65536      # larger raw payloads go to the blob store

# --- OCR (optional; disabled by default — OCR is expensive) ----------------
OCR_ENABLED=false
OCR_LANGUAGES=eng

# --- AI enrichment (OPTIONAL — the core API runs without these) ------------
AI_ENABLED=false
AI_PROVIDER=null                        # null | openai | anthropic
AI_API_KEY=
AI_MODEL=

# --- API behaviour ---------------------------------------------------------
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100
STATISTICS_CACHE_SECONDS=60

# --- Rate limiting ---------------------------------------------------------
# Implemented in Redis with a per-process fallback. Defaults to on in
# production/staging, off elsewhere.
# RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANONYMOUS_PER_MINUTE=20
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=60
RATE_LIMIT_ADMIN_PER_MINUTE=600
# Extra requests allowed in a one-minute window before the sustained limit
# engages (total allowance per window = limit + burst).
RATE_LIMIT_BURST=20
# true  — if Redis is unreachable, enforce per process and keep serving
#         (X-RateLimit-Policy reports "in-process (redis unavailable)").
# false — answer 503 RATE_LIMIT_BACKEND_UNAVAILABLE on protected endpoints, and
#         report the process as not ready. Choose false only if exceeding a
#         limit is worse than losing read availability during a Redis outage.
RATE_LIMIT_FAIL_OPEN=true
# Bound on fallback buckets so a flood of distinct client IPs cannot exhaust
# the API's memory (oldest window evicted first).
RATE_LIMIT_FALLBACK_MAX_ENTRIES=10000
